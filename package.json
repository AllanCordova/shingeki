{
  "name": "shingeki",
  "private": true,
  "description": "Scripts da raiz: npm run dev sobe API e client juntos.",
  "scripts": {
    "dev": "concurrently -k -n api,client -c blue,green \"npm run dev:api\" \"npm run dev:client\"",
    "dev:api": "php apps/api/artisan serve",
    "dev:client": "npm run dev --prefix apps/client",
    "test:dast-juice": "go run -C workers/dast ./cmd/harness -target http://127.0.0.1:3001",
    "test:dast-juice-auth": "go run -C workers/dast ./cmd/harness -target http://127.0.0.1:3001 -auth",
    "test:dast-juice-coverage": "go run -C workers/dast ./cmd/harness -target http://127.0.0.1:3001 -coverage"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
