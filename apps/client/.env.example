API_BASE_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_MEDIA_BASE_URL=http://127.0.0.1:8000

# Optional: Chrome/Edge extension ID from chrome://extensions (content script on localhost works without this)
# NEXT_PUBLIC_SHINGEKI_EXTENSION_ID=

# Google login uses the Laravel OIDC flow (API_BASE_URL/auth/google/*).
# Configure GOOGLE_* on the API; BFF routes are /api/auth/google and /api/auth/google/callback.

PEXELS_API_KEY=
