APP_NAME=Shingeki
APP_ENV=local
APP_KEY=base64:0YQq7LwkPB/CxJH+0bCjOXC5FvH0q9t1lcsmy7H/v8A=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:3000
# Optional comma-separated extras (localhost/127.0.0.1:3000 are already allowed):
# FRONTEND_ALLOWED_ORIGINS=http://192.168.0.10:3000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shingeki_api
DB_USERNAME=root
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=rabbitmq
CACHE_STORE=database

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_ATTACKS_DISPATCH_QUEUE=attacks.dispatch
RABBITMQ_ATTACKS_SAST_DISPATCH_QUEUE=attacks.sast.dispatch
RABBITMQ_ATTACKS_RESULTS_QUEUE=attacks.results
RABBITMQ_CATALOG_ATTACKS_IMPORT_QUEUE=catalog.attacks.import
RABBITMQ_CATALOG_REMEDIATIONS_IMPORT_QUEUE=catalog.remediations.import
CATALOG_IMPORT_MAX_ROWS=200
CATALOG_IMPORT_CHUNK_SIZE=50

ATTACKS_CATALOG_ADMIN_EMAIL=catalog-owner@shingeki.local
DEMO_SEED=false
DEMO_USER_PASSWORD=
SSRF_ALLOW_PRIVATE_NETWORKS=true
SSRF_RESOLVE_DNS=true
SANCTUM_TOKEN_EXPIRATION=10080
GITHUB_ALLOWED_REPOSITORIES=
GITHUB_REQUIRE_REPOSITORY_ALLOWLIST=false
RABBITMQ_SSL=false
VULNERABLE_TARGET_URL=http://127.0.0.1:8090
VULNERABLE_TARGET_WORKER_URL=http://vulnerable-target
VULNERABLE_TARGET_SIGNATURE_TOKEN=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_MAX_FINDINGS_PER_REQUEST=5

GITHUB_TOKEN=
GITHUB_DEFAULT_BRANCH=master
GITHUB_REPOSITORY_SOURCE_PREFIX=shingeki-vulnerable-target
GITHUB_REMEDIATION_BRANCH_PREFIX=fix-security

# Google OIDC (Sign in with Google). Create an OAuth 2.0 Web client in Google Cloud Console.
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorized redirect URI in Google Cloud Console exactly.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
