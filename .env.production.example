# Copy to .env.production (gitignored) and replace every change-me value.
#   cp .env.production.example .env.production

# Caddy speaks plain HTTP. Cloudflare (or Tailscale Funnel) terminates HTTPS.
SITE_ADDRESS=:80
# Hostname testers open. Stays the same when the home IP changes.
PUBLIC_URL=https://shingeki.seudominio.com

# Bind Caddy on this machine only. A public VPS should use 80 and 443.
HTTP_BIND=127.0.0.1:80
HTTPS_BIND=127.0.0.1:443

# Token from Cloudflare Zero Trust → Tunnels. The public hostname service
# must be http://caddy:80 (the container name, not localhost).
CLOUDFLARE_TUNNEL_TOKEN=

APP_NAME=Shingeki
APP_ENV=production
APP_KEY=
APP_DEBUG=false
LOG_LEVEL=warning

DB_DATABASE=shingeki_api
DB_USERNAME=root
DB_PASSWORD=change-me-db

RABBITMQ_USER=shingeki
RABBITMQ_PASSWORD=change-me-rabbit
RABBITMQ_VHOST=/

# true when the browser uses HTTPS (domain or Cloudflare Tunnel).
COOKIE_SECURE=true

MAIL_MAILER=log

GITHUB_TOKEN=

# 32 bytes in base64. Shared by the API and the DAST workers.
# Generate: openssl rand -base64 32
BROWSER_STATE_KEY=
BROWSER_CAPTURE_TTL_MINUTES=15
CAPTURE_SERVICE_TOKEN=
# noVNC stays on the host loopback. Do not publish it through Caddy.
# The API appends a per-session password when it returns novnc_url.
# CAPTURE_NOVNC_PUBLIC_URL=http://127.0.0.1:6080/vnc.html?autoconnect=1&resize=scale

GEMINI_API_KEY=
GROQ_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact redirect URI registered in Google Cloud. Empty skips Google login.
# GOOGLE_REDIRECT_URI=https://seudominio.com/oauth/google/callback
