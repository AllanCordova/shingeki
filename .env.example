# Laravel
APP_NAME=Shingeki
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shingeki_api
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=rabbitmq

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Infra (Docker)
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_ATTACKS_DISPATCH_QUEUE=attacks.dispatch
RABBITMQ_ATTACKS_RESULTS_QUEUE=attacks.results
RABBITMQ_PREFETCH=1

ATTACKS_CATALOG_ADMIN_EMAIL=admin@admin.com

VULNERABLE_TARGET_URL=http://host.docker.internal:8090
VULNERABLE_TARGET_PORT=8090
VULNERABLE_TARGET_SIGNATURE_TOKEN=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

# DAST Worker
WORKER_JOB_TIMEOUT=30m
WORKER_ATTACK_CONCURRENCY=5

DISCOVERY_MAX_DEPTH=3
DISCOVERY_MAX_PAGES=50
DISCOVERY_PAGE_TIMEOUT=30s
DISCOVERY_ROD_ENABLED=false
DISCOVERY_ROD_HEADLESS=true
DISCOVERY_MIN_VECTORS_FOR_ROD=2

ATTACK_REQUEST_TIMEOUT=15s
ATTACK_RATE_LIMIT_RPS=10
ATTACK_MAX_BODY_BYTES=1048576
ATTACK_USER_AGENT=Shingeki-DAST-Worker/1.0

EVIDENCE_BODY_DIFF_THRESHOLD=100
EVIDENCE_TIMING_TOLERANCE=2s
