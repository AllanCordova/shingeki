DB_DATABASE=shingeki_api
DB_PASSWORD=secret
DB_PORT=3306

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VHOST=/
RABBITMQ_ATTACKS_DISPATCH_QUEUE=attacks.dispatch
RABBITMQ_ATTACKS_SAST_DISPATCH_QUEUE=attacks.sast.dispatch
RABBITMQ_ATTACKS_CANCEL_QUEUE=attacks.dispatch.cancel
RABBITMQ_ATTACKS_SAST_CANCEL_QUEUE=attacks.sast.dispatch.cancel
RABBITMQ_ATTACKS_RESULTS_QUEUE=attacks.results
RABBITMQ_CATALOG_ATTACKS_IMPORT_QUEUE=catalog.attacks.import
RABBITMQ_CATALOG_REMEDIATIONS_IMPORT_QUEUE=catalog.remediations.import
CATALOG_IMPORT_MAX_ROWS=200
CATALOG_IMPORT_CHUNK_SIZE=50

GITHUB_TOKEN=

# 32 bytes in base64. Same value on the API and the DAST worker.
# Generate: openssl rand -base64 32
BROWSER_STATE_KEY=
BROWSER_CAPTURE_TTL_MINUTES=15
CAPTURE_SERVICE_URL=http://127.0.0.1:7900
CAPTURE_SERVICE_TOKEN=
CAPTURE_NOVNC_PUBLIC_URL=http://127.0.0.1:6080/vnc.html?autoconnect=1&resize=scale
# URL the capture container uses to return the session. With the local capture service on the host network, this is the API on 127.0.0.1.
# CAPTURE_COMPLETE_BASE_URL=http://127.0.0.1:8000
