RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_ATTACKS_DISPATCH_QUEUE=attacks.dispatch
RABBITMQ_ATTACKS_RESULTS_QUEUE=attacks.results
RABBITMQ_PREFETCH=1

WORKER_JOB_TIMEOUT=30m
WORKER_ATTACK_CONCURRENCY=5

DISCOVERY_MAX_DEPTH=3
DISCOVERY_MAX_PAGES=50
DISCOVERY_MAX_CLICKS=80
DISCOVERY_MAX_FORM_SUBMITS=8
DISCOVERY_PAGE_TIMEOUT=30s
DISCOVERY_BROWSER_LAUNCH_TIMEOUT=90s
DISCOVERY_EXPLORE_SETTLE=1500ms
DISCOVERY_ROD_ENABLED=true
DISCOVERY_ROD_HEADLESS=true
DISCOVERY_ROD_NO_SANDBOX=true

# Optional: attach the worker to the user's Chrome instead of launching headless Chromium.
# Start Chrome with: google-chrome --remote-debugging-port=9222
# DISCOVERY_CDP_URL=http://host.docker.internal:9222
#
# Optional: send crawl traffic through the user's network (same IP as the captured session).
# DISCOVERY_PROXY=socks5://host.docker.internal:1080

ATTACK_REQUEST_TIMEOUT=15s
ATTACK_RATE_LIMIT_RPS=10
ATTACK_MAX_BODY_BYTES=1048576
ATTACK_MAX_JOBS=2500
ATTACK_USER_AGENT=Shingeki-DAST-Worker/1.0

EVIDENCE_BODY_DIFF_THRESHOLD=100
EVIDENCE_TIMING_TOLERANCE=2s

CHROME_PATH=/usr/bin/chromium
TARGET_LOCALHOST_REWRITE=host.docker.internal
